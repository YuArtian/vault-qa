# 复制本文件为 .env（.env 已被 gitignore，永远不会进仓库）

# 后端选择：claude = 复用本机 Claude Code 登录，零配置（默认）；openai = 任何 OpenAI 兼容服务商
# LLM_PROVIDER=claude

# —— 以下仅 LLM_PROVIDER=openai 时需要 ——
# LLM_API_KEY=在这里填你的key

# 用 OpenAI 官方就不用改下面；用其他服务商时取消对应两行的注释：

# —— DeepSeek ——
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# —— OpenRouter（一个 key 用所有模型）——
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash

# —— Gemini（OpenAI 兼容端点）——
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# 知识库范围（默认整个 Library；想只问 Python 笔记就取消注释）
# VAULT_DIR=~/Documents/Obsidian Vault/Marauder'sMap/Library/Python
